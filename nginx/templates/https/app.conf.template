# Production edge config: TLS termination + HTTP->HTTPS redirect.
#
# Requires a certificate at /etc/letsencrypt/live/${DOMAIN}/ — nginx refuses to
# start without one. Run scripts/init-letsencrypt.sh first; it stages a
# temporary self-signed cert so nginx can boot, then swaps in the real one.

upstream glamedge_api {
    server api:4000;
}

upstream glamedge_web {
    server web:80;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Renewals are also webroot-based, so this must stay reachable over HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS is deliberately left commented: once a browser sees it, this domain is
    # HTTPS-only for max-age. Enable it after you've confirmed certs renew.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
    }

    location /uploads/ {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
        expires 30d;
        add_header Cache-Control "public";
    }

    location /health {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
        access_log off;
    }

    # SEO: the API injects per-salon meta/JSON-LD into the SPA shell so crawlers
    # that don't execute JS still see real content — see seo.controller.ts. Must
    # come before the generic "location /" so it wins for these two paths only.
    location /salon/ {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
    }

    location = /sitemap.xml {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
    }

    # Socket.IO needs the connection upgraded and a long read timeout, otherwise
    # idle websockets get cut every 60s and the client reconnect-storms.
    location /socket.io/ {
        proxy_pass http://glamedge_api;
        include /etc/nginx/includes/proxy.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://glamedge_web;
        include /etc/nginx/includes/proxy.conf;
    }
}
