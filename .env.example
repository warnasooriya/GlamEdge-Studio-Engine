# ---------------------------------------------------------------------------
# Copy this file to .env (root) and to apps/api/.env, then fill in real values.
# Local dev defaults (docker-compose) are pre-filled; swap for your cloud
# instances when ready to go to production. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- MySQL (Prisma) ---------------------------------------------------------
# Local docker-compose default. Replace with your managed MySQL 8 instance
# (e.g. AWS RDS) for production: mysql://user:pass@host:3306/db
# Note: mapped to host port 3307 (not 3306) to avoid clashing with any MySQL
# server already running locally on this machine.
DATABASE_URL="mysql://glamedge:glamedge_pw@localhost:3307/glamedge?connection_limit=20&pool_timeout=30"

# --- MongoDB Atlas (social feed) -------------------------------------------
# Local docker-compose default. Replace with your MongoDB Atlas URI for prod.
MONGODB_URI="mongodb://localhost:27017/glamedge_feed"

# --- Redis (OTP rate-limiting, Socket.io adapter) ---------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth --------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- OTP provider -------------------------------------------------------------
# "console" (default, dev): OTP is printed to the API server logs.
# "textlk": real SMS via Text.lk (Sri Lanka) — https://app.text.lk/developers/http-docs
# "notifylk": real SMS via Notify.lk (Sri Lanka).
OTP_PROVIDER="console"
TEXTLK_API_TOKEN=""
# Required by Text.lk on every send (unlike Notify.lk's optional sender_id) —
# max 11 alphanumeric characters, must be an approved sender on your account.
TEXTLK_SENDER_ID=""
NOTIFYLK_USER_ID=""
NOTIFYLK_API_KEY=""
NOTIFYLK_SENDER_ID=""

# --- AWS S3 (media storage) --------------------------------------------------
# Leave blank to use local disk storage (apps/api/uploads) in dev.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_CLOUDFRONT_URL=""

# --- WhatsApp Cloud API (instant e-billing) ----------------------------------
# Leave blank to log invoice sends to the console instead of dispatching.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- PayPal (customer bill payments) -----------------------------------------
# From a PayPal Developer REST API app (https://developer.paypal.com/dashboard/applications).
# Platform-level credentials only — each salon just enters their own PayPal
# email in Settings; funds route directly to them via payee.email_address.
# Leave blank to disable PayPal as a billing option.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
# PayPal doesn't settle in LKR, so checkout converts to USD using a live rate
# (apps/api/src/services/fx/exchangeRateService.ts). This is only the fallback
# used if that lookup fails.
PAYPAL_FALLBACK_LKR_PER_USD="300"

# --- API server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Public origin of the customer-facing web app, used to build shareable links
# (e.g. the salon profile QR code). Defaults to CORS_ORIGIN if left blank.
FRONTEND_URL=""

# --- Frontend (apps/web) -------------------------------------------------------
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"
# Same PayPal REST app as PAYPAL_CLIENT_ID above — this one is safe to expose
# publicly (it's what the PayPal JS SDK script tag needs), unlike the secret.
VITE_PAYPAL_CLIENT_ID=""
# Google Cloud project with "Maps JavaScript API" + "Places API" enabled.
# Leave blank to disable the salon-location map picker (Settings page falls
# back to a "not configured" message instead of rendering a map).
VITE_GOOGLE_MAPS_API_KEY="AIzaSyBjmDhbFdX8o0NsoIbqHbiuzvcgdWxIN0w"
