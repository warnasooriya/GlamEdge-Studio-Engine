# ---------------------------------------------------------------------------
# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env
#
# This file configures the Docker stack only. apps/api/.env is for running the
# API directly on the host with pnpm dev and is not read by the containers.
# ---------------------------------------------------------------------------

# --- Where the app is reachable ---------------------------------------------
# Local:      DOMAIN=localhost   NGINX_TEMPLATE=http    PUBLIC_URL=http://localhost
# Production: DOMAIN=app.example.com  NGINX_TEMPLATE=https  PUBLIC_URL=https://app.example.com
DOMAIN=localhost
NGINX_TEMPLATE=http
# Origin the browser uses. Sets CORS and the base for locally-stored upload URLs.
PUBLIC_URL=http://localhost

# --- Certbot (production only) ----------------------------------------------
# Used by scripts/init-letsencrypt.sh when issuing the first certificate.
CERTBOT_EMAIL=you@example.com
# 1 = hit Let's Encrypt's staging CA (untrusted certs, but generous rate limits).
# Always issue once with 1 to prove the flow works, then set 0 for the real cert.
CERTBOT_STAGING=1
# Uncomment once HTTPS is live (see DEPLOYMENT.md "HTTPS"). This is what keeps
# the certbot renewal container included in every future `docker compose up` —
# including the one the GitHub Actions deploy runs — without editing the
# workflow. Compose reads this from .env automatically, no --profile flag needed.
# COMPOSE_PROFILES=tls

# --- Secrets -----------------------------------------------------------------
# REQUIRED — the API refuses to start without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account, created on boot only if no admin exists yet.
# Leave ADMIN_PASSWORD blank and one is generated and printed to the API logs
# (docker compose logs api) — safer than committing a password here.
ADMIN_EMAIL=admin@glamedge.dev
ADMIN_PASSWORD=

# --- Datastores ---------------------------------------------------------------
# Change these before any real deployment.
MYSQL_ROOT_PASSWORD=glamedge_root
MYSQL_DATABASE=glamedge
MYSQL_USER=glamedge
MYSQL_PASSWORD=glamedge_pw
MONGO_DATABASE=glamedge_feed

# Host ports for admin tooling; all bound to 127.0.0.1, never publicly exposed.
MYSQL_HOST_PORT=3307
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379

# --- OTP delivery -------------------------------------------------------------
# "console" prints codes to the API logs (dev). "textlk" and "notifylk" send real SMS.
OTP_PROVIDER=console
# Text.lk (https://app.text.lk/developers/http-docs). sender_id is required on
# every send — max 11 alphanumeric characters, must be approved on your account.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=

# --- Media storage ------------------------------------------------------------
# Leave blank to store uploads on the api_uploads volume. Set all four to use S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# --- WhatsApp Cloud API -------------------------------------------------------
# Blank = invoice/notification sends are logged instead of dispatched.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Frontend build args ------------------------------------------------------
# Vite bakes these in at build time, so changing them needs a rebuild:
#   docker compose build web
# The "/" defaults keep the bundle same-origin, which works on any domain.
VITE_API_URL=/
VITE_SOCKET_URL=/
VITE_GOOGLE_MAPS_API_KEY=
