# Point these at your apps/api instance.
# localhost will NOT resolve from a physical device or simulator's network
# namespace the same way it does in a browser — use your machine's LAN IP
# (e.g. http://192.168.1.20:4000) when testing on Expo Go / a device.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Same Google Maps key used by apps/web (VITE_GOOGLE_MAPS_API_KEY) — powers the
# address search + map in Settings > Location. Needs the Places and Geocoding
# APIs enabled on the Google Cloud project.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
