// prisma/schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CategoryType {
  LADIES
  GENTS
  KIDS
}

enum SubscriptionTier {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY
}

enum TenantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum PaymentMode {
  CASH
  CARD
  ONLINE
  LANKAQR
  PAYPAL
}

enum PaypalPaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  REVIEW_THANKS
  INVOICE_READY
  RESCHEDULE_PROPOSED
  RESCHEDULE_ACCEPTED
  RESCHEDULE_DECLINED
  NEW_MESSAGE
  REVIEW_SUBMITTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
}

enum RescheduleStatus {
  NONE
  PROPOSED
}

model Tenant {
  id                    String             @id @default(uuid())
  salonName             String             @db.VarChar(191)
  slug                  String             @unique @db.VarChar(191)
  phone                 String             @unique @db.VarChar(50)
  ownerName             String             @db.VarChar(191)
  subscription          SubscriptionTier   @default(STARTER)
  isActive              Boolean            @default(true)
  status                TenantStatus       @default(PENDING)
  rejectionReason       String?            @db.VarChar(500)
  approvedAt            DateTime?
  subscriptionCycle     SubscriptionCycle  @default(MONTHLY)
  subscriptionFee       Decimal            @default(0.00) @db.Decimal(10, 2)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  expiryNotifiedAt      DateTime?
  logoUrl               String?            @db.VarChar(500)
  address               String?            @db.Text
  mapLink               String?            @db.VarChar(500)
  latitude              Float?
  longitude             Float?
  contactPhone          String?            @db.VarChar(50)
  // Where PayPal sends customer payments — the platform's own PayPal REST
  // app creates each order with this as payee.email_address, so funds route
  // straight to the salon with no PayPal Partner/OAuth approval needed.
  paypalEmail           String?            @db.VarChar(191)
  // Both null = not configured yet, and every existing behavior (9am-8pm,
  // every day) stays exactly as it was before this feature — see
  // apps/api/src/utils/businessHours.ts for the fallback.
  openTime              String?            @db.VarChar(5) // "09:00"
  closeTime             String?            @db.VarChar(5) // "20:00"
  workingDays           Json? // int[] using JS Date.getDay() (0=Sunday..6=Saturday)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  services             Service[]
  staff                Staff[]
  appointments         Appointment[]
  ledgers              Ledger[]
  reviews              Review[]
  notifications        Notification[]
  ownerNotifications   OwnerNotification[]
  subscriptionPayments SubscriptionPayment[]
  paypalPayments       PaypalPayment[]

  @@map("tenants")
}

model Service {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    CategoryType
  name        String       @db.VarChar(191)
  price       Decimal      @db.Decimal(10, 2)
  durationMin Int          @default(30)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  appointments AppointmentService[]

  @@index([tenantId])
  @@map("services")
}

model Staff {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(191)
  phone      String?  @db.VarChar(50)
  role       String   @default("Stylist") @db.VarChar(100)
  commission Decimal  @default(0.00) @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  appointments            Appointment[]
  proposedForAppointments Appointment[] @relation("ProposedStaff")

  @@index([tenantId])
  @@map("staff")
}

model Appointment {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId             String?
  staff               Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  clientId            String?
  client              Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName          String            @db.VarChar(191)
  clientPhone         String            @db.VarChar(50)
  category            CategoryType
  bookingTime         DateTime
  status              AppointmentStatus @default(PENDING)
  isBilled            Boolean           @default(false)
  notes               String?           @db.Text
  proposedBookingTime DateTime?
  proposedStaffId     String?
  proposedStaff       Staff?            @relation("ProposedStaff", fields: [proposedStaffId], references: [id], onDelete: SetNull)
  rescheduleStatus    RescheduleStatus  @default(NONE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  services      AppointmentService[]
  ledger        Ledger?
  review        Review?
  paypalPayment PaypalPayment?

  @@index([tenantId])
  @@index([bookingTime])
  @@index([clientId])
  @@map("appointments")
}

model Client {
  id        String   @id @default(uuid())
  phone     String   @unique @db.VarChar(50)
  name      String   @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  notifications Notification[]

  @@map("clients")
}

model Notification {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  type          NotificationType
  title         String           @db.VarChar(191)
  message       String           @db.Text
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([clientId])
  @@map("notifications")
}

model OwnerNotification {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  type          NotificationType
  title         String           @db.VarChar(191)
  message       String           @db.Text
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([tenantId])
  @@map("owner_notifications")
}

model AppointmentService {
  appointmentId String
  serviceId     String
  price         Decimal     @db.Decimal(10, 2)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model Ledger {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type          LedgerType
  amount        Decimal      @db.Decimal(10, 2)
  category      String       @db.VarChar(100)
  paymentMode   PaymentMode  @default(CASH)
  description   String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("ledgers")
}

// A "Pay Now" link generated at billing time: the customer completes payment
// remotely (see apps/api/src/modules/payments), and only then does the
// appointment get finalized the same way a cash sale is — see
// billing.service.ts finalizeInvoice(). amountUsd/fxRate are recorded at the
// moment checkout actually happens (not link-creation time) since PayPal
// doesn't settle in LKR and rates drift while a link sits unpaid.
model PaypalPayment {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId   String              @unique
  appointment     Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amountLkr       Decimal             @db.Decimal(10, 2)
  amountUsd       Decimal?            @db.Decimal(10, 2)
  fxRate          Decimal?            @db.Decimal(10, 4)
  status          PaypalPaymentStatus @default(PENDING)
  paypalOrderId   String?             @db.VarChar(64)
  paypalCaptureId String?             @db.VarChar(64)
  payerEmail      String?             @db.VarChar(191)
  createdAt       DateTime            @default(now())
  completedAt     DateTime?

  @@index([tenantId])
  @@map("paypal_payments")
}

model Review {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientName    String      @db.VarChar(191)
  rating        Int         @default(5)
  comment       String?     @db.Text
  isVerified    Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([tenantId])
  @@map("reviews")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recordedPayments SubscriptionPayment[]

  @@map("admins")
}

// One row per subscription fee collected from a salon. Immutable ledger: renewing
// a subscription records a payment covering periodStart..periodEnd, so the admin
// can always reconstruct what a salon paid and for which window.
model SubscriptionPayment {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount       Decimal           @db.Decimal(10, 2)
  tier         SubscriptionTier
  cycle        SubscriptionCycle
  paymentMode  PaymentMode       @default(CASH)
  reference    String?           @db.VarChar(191)
  notes        String?           @db.VarChar(500)
  periodStart  DateTime
  periodEnd    DateTime
  paidAt       DateTime          @default(now())
  recordedById String?
  recordedBy   Admin?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([tenantId])
  @@index([paidAt])
  @@map("subscription_payments")
}
